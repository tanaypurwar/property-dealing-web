---
import { getCollection } from 'astro:content';
import Button from '../../components/Button.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingMinutes } from '../../lib/format';
import { whatsappUrl } from '../../lib/whatsapp';

const posts = (await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<BaseLayout
  title="Blog: buying property in Noida and Greater Noida"
  description="Plain-language guides on locations, RERA, pricing and payment plans in Noida and Greater Noida, from the Property Dealing Team."
>
  <div class="mx-auto max-w-site px-4 pt-10 pb-16 sm:px-6 md:pt-16 md:pb-24">
    <header class="max-w-[44rem]">
      <h1 class="text-h2 font-extrabold md:text-h1">Read before you sign</h1>
      <p class="mt-3 text-lead text-stone">
        Guides on locations, RERA, pricing and payment plans in Noida and Greater Noida, with our
        sources at the end of every post.
      </p>
    </header>

    {
      posts.length === 0 ? (
        <div class="mt-10 flex flex-col items-start gap-4 rounded-card border border-dashed border-stone/50 bg-sand/60 p-6">
          <p class="text-stone">The first guides are being written. Have a question now? Ask us directly.</p>
          <Button variant="whatsapp" icon="chat" href={whatsappUrl()} target="_blank" rel="noopener">Ask on WhatsApp</Button>
        </div>
      ) : (
        <ol class="mt-10 divide-y divide-line border-y border-line">
          {posts.map((post) => (
            <li>
              <article class="grid gap-2 py-6 md:grid-cols-[10rem_1fr] md:gap-8">
                <p class="text-small text-stone tabular-nums">
                  <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>{formatDate(post.data.publishedAt)}</time>
                  <span class="block">{readingMinutes(post.body ?? '')} min read</span>
                </p>
                <div class="max-w-[60ch]">
                  <h2 class="text-h4 font-bold">
                    <a href={`/blog/${post.id}`} class="hover:text-deep hover:underline">{post.data.title}</a>
                  </h2>
                  <p class="mt-2 text-stone">{post.data.description}</p>
                  {post.data.draft && <p class="mt-2 text-small font-bold text-deep">Draft, only visible in astro dev</p>}
                </div>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>
