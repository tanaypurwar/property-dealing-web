---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { formatDate, readingMinutes } from '../../lib/format';
import { whatsappUrl } from '../../lib/whatsapp';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const minutes = readingMinutes(post.body ?? '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: isoDate(data.publishedAt),
    dateModified: isoDate(data.updatedAt ?? data.publishedAt),
    author: { '@type': 'Organization', name: data.author },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
    mainEntityOfPage: canonical,
    keywords: data.tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? site.url).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site ?? site.url).href },
      { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
    ],
  },
];
---

<BaseLayout title={data.title} description={data.description} ogType="article" jsonLd={jsonLd} noindex={data.draft} floatingWhatsApp={false}>
  <article class="mx-auto max-w-site px-4 pt-4 pb-16 sm:px-6 md:pb-24">
    <nav aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-x-1 text-small text-stone">
        <li><a href="/" class="inline-flex min-h-tap items-center hover:text-deep hover:underline">Home</a></li>
        <li aria-hidden="true"><Icon name="chevronRight" size={14} /></li>
        <li><a href="/blog" class="inline-flex min-h-tap items-center hover:text-deep hover:underline">Blog</a></li>
        <li aria-hidden="true"><Icon name="chevronRight" size={14} /></li>
        <li aria-current="page" class="line-clamp-1 font-medium text-ink">{data.title}</li>
      </ol>
    </nav>

    <header class="mt-6 max-w-[48rem] md:mt-10">
      <h1 class="text-h3 font-extrabold md:text-h2 lg:text-[3.0625rem] lg:leading-[1.1]">{data.title}</h1>
      <p class="mt-4 text-lead text-stone">{data.description}</p>
      <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-small text-stone">
        <span>By {data.author}</span>
        <time datetime={isoDate(data.publishedAt)}>Published {formatDate(data.publishedAt)}</time>
        {data.updatedAt && <time datetime={isoDate(data.updatedAt)}>Updated {formatDate(data.updatedAt)}</time>}
        <span>{minutes} min read</span>
      </p>
    </header>

    <div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-16">
      <div class="prose-site">
        <Content />
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Talk to an advisor">
        <div class="rounded-card bg-ink p-6 text-paper">
          <p class="font-display text-lead font-extrabold">Weighing a project in this area?</p>
          <p class="mt-2 text-paper/80">
            Send us the project name. We'll check its RERA status and get the all-inclusive price in
            writing before you pay anything.
          </p>
          <div class="mt-5 flex flex-col gap-3">
            <Button href={whatsappUrl(`Namaste! I read "${data.title}". Can you help me check a project?`)} variant="whatsapp" icon="chat" block target="_blank" rel="noopener">
              Ask on WhatsApp
            </Button>
            <Button href={site.enquireHref} variant="inverse" block>Request a callback</Button>
          </div>
        </div>
      </aside>
    </div>

    {
      data.sources.length > 0 && (
        <section aria-labelledby="sources-title" class="mt-14 max-w-[68ch] border-t border-line pt-8">
          <h2 id="sources-title" class="font-display text-lead font-bold">Sources</h2>
          <ol class="mt-3 flex list-decimal flex-col gap-2 pl-6 text-small text-stone">
            {data.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener" class="text-ink underline decoration-line underline-offset-2 hover:text-deep">
                  {s.title}
                </a>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-small text-stone">
            This article is general information, not financial advice. Plans, timelines and prices
            can change; check the latest RERA filing on up-rera.in before you pay any amount.
          </p>
        </section>
      )
    }
  </article>
</BaseLayout>
