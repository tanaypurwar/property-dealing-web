---
import { getCollection } from 'astro:content';
import HeroCarousel from '../components/media/HeroCarousel.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Ring from '../components/Ring.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnquirySection from '../components/EnquirySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { promises } from '../lib/brand-content';
import { formatDate } from '../lib/format';
import PriceTag from '../components/PriceTag.astro';
import {
  areaSummary,
  configurationSummary,
  priceLabel,
  projectUrl,
  toListingItem,
} from '../lib/project';
import { BUDGETS, DEFAULT_SORT, matches, type FilterState } from '../lib/project-filters';
import { projectWhatsappMessage, whatsappUrl } from '../lib/whatsapp';

const published = (await getCollection('projects', ({ data }) => data.published)).map((e) => e.data);

const newestFirst = [...published].sort((a, b) => b.listedAt.getTime() - a.listedAt.getTime());

// The spotlight at the top of the page: the newest *featured* RERA-registered project, or if none
// is featured, the newest RERA-registered one. Projects with RERA only "applied for" aren't promoted.
const registered = newestFirst.filter((p) => p.reraStatus === 'registered');
const latest = registered.find((p) => p.featured) ?? registered[0];
const latestArea = latest && `${latest.location.sector}, ${latest.location.city}`;
// Spotlight carousel: the developer's ad first (shown whole), then the main image and gallery.
const latestSlides = latest
  ? [
      ...(latest.images.promo ? [{ ...latest.images.promo, contain: true }] : []),
      { src: latest.images.hero.src, alt: latest.images.hero.alt, caption: latest.images.hero.caption },
      ...latest.images.gallery.slice(0, 6).map((g) => ({ src: g.src, alt: g.caption, caption: g.caption })),
    ]
  : [];

// The grid below: everything else, newest first, three cards at most.
const showcase = newestFirst.filter((p) => p !== latest).slice(0, 3);

// "Browse by" tiles, counted with the same rules as the /projects filters. Empty ones are hidden.
const items = published.map(toListingItem);
const none: FilterState = { location: '', type: '', status: '', bhk: '', budget: '', sort: DEFAULT_SORT };
const tiles = [
  ...BUDGETS.map((b) => ({ label: b.label, state: { ...none, budget: b.value } })),
  { label: 'Homes', state: { ...none, type: 'residential' } },
  { label: 'Shops, offices and studios', state: { ...none, type: 'commercial' } },
  { label: 'Ready to move', state: { ...none, status: 'ready-to-move' } },
  { label: 'New launches', state: { ...none, status: 'upcoming' } },
]
  .map((t) => {
    const params = new URLSearchParams(
      Object.entries(t.state).filter(([k, v]) => v && k !== 'sort') as [string, string][],
    );
    return { ...t, href: `/projects?${params}`, count: items.filter((i) => matches(i, t.state)).length };
  })
  .filter((t) => t.count > 0);

// The price-sheet "receipt": every line we itemise before a site visit (brand book, Pillar 2).
const sheet = [
  { item: 'Basic sale price (BSP)', note: 'per sq. ft. × area' },
  { item: 'Preferred location charge', note: 'floor, facing, corner' },
  { item: 'IFMS', note: 'one-time maintenance deposit' },
  { item: 'Car parking', note: '' },
  { item: 'Club membership', note: '' },
  { item: 'GST', note: '' },
  { item: 'Stamp duty and registry', note: '' },
];

const trust = ['RERA-certified advisor', 'All-inclusive pricing', 'One advisor till registry', 'No spam calls'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    name: site.name,
    url: site.url,
    slogan: site.tagline,
    telephone: site.phone,
    email: site.email,
    address: { '@type': 'PostalAddress', addressLocality: 'Noida', postalCode: '201307', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
    areaServed: ['Noida', 'Greater Noida'],
    founder: { '@type': 'Person', name: site.founder.name },
    sameAs: site.social.map((s) => s.href),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url },
];

const section = 'mx-auto max-w-site px-4 sm:px-6';
---

<BaseLayout
  title="Verified projects in Noida and Greater Noida"
  description="RERA-checked residential and commercial projects in Noida and Greater Noida, each with an itemised price sheet before your site visit, and one advisor till registry."
  jsonLd={jsonLd}
>
  <meta slot="head" name="facebook-domain-verification" content="owlgfhgjfhxpqmscbmddv178fw6a56" />
  <!-- Just listed: the newest RERA-registered project, first thing on the page. -->
  {
    latest && latestArea && (
      <section aria-labelledby="latest-title" class="border-b border-line bg-surface/60">
        <div class:list={[section, 'grid gap-6 py-6 md:py-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-center lg:gap-12']}>
          <HeroCarousel label={`${latest.name} images`} slides={latestSlides} variant="compact" />
          <div class="flex flex-col gap-3">
            <p class="reveal-load [--step:0] flex items-center gap-2 text-small font-semibold text-champagne">
              <span aria-hidden="true" class="size-2 rounded-full bg-champagne" />
              {latest.featured ? 'Featured project' : `Just listed on ${formatDate(latest.listedAt)}`}
            </p>
            <div class="reveal-load [--step:1]">
              <p class="text-body font-medium text-mist">{latest.developer}</p>
              <h2 id="latest-title" class="text-h3 font-medium md:text-h2">
                <a href={projectUrl(latest.slug)} class="decoration-1 underline-offset-[6px] hover:text-champagne hover:underline">{latest.name}</a>
              </h2>
            </div>
            <p class="reveal-load [--step:2] text-lead text-mist">{latestArea}</p>
            <div class="reveal-load [--step:2] flex flex-wrap gap-1.5">
              <Badge category={latest.type} />
              <Badge status={latest.status} />
            </div>
            <ul class="reveal-load [--step:3] flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem] text-alabaster/90">
              <li>{configurationSummary(latest.configurations)}</li>
              <li class="figures">
                {areaSummary(latest.configurations).label === 'Area'
                  ? 'Area on request'
                  : `${areaSummary(latest.configurations).value} ${areaSummary(latest.configurations).label.toLowerCase()}`}
              </li>
            </ul>
            <PriceTag
              min={latest.priceRange.min}
              max={latest.priceRange.max}
              from={latest.priceRange.max === undefined}
              note={priceLabel(latest)}
              size="lg"
              class="reveal-load [--step:3]"
            />
            <p class="reveal-load [--step:4] flex items-center gap-1.5 text-small text-mist">
              <Ring />
              <span>UP RERA <span class="figures">{latest.reraNumber}</span></span>
            </p>
            <div class="reveal-load [--step:4] mt-2 grid grid-cols-2 gap-2 sm:flex">
              <Button href={projectUrl(latest.slug)} size="lg">View details</Button>
              <Button
                href={whatsappUrl(projectWhatsappMessage(latest.name, latestArea))}
                variant="whatsapp"
                icon="chat"
                size="lg"
                target="_blank"
                rel="noopener"
              >
                WhatsApp
              </Button>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Hero: the promise on the left, the price sheet it refers to on the right. -->
  <section aria-labelledby="hero-title" class:list={[section, 'grid items-center gap-12 pt-12 pb-16 md:pt-20 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-24 lg:pt-28 lg:pb-28']}>
    <div>
      <h1 id="hero-title" class="reveal-load [--step:2] text-h2 font-medium md:text-h1">
        Verified projects in Noida and Greater Noida.
        <span class="block">Full price, upfront.</span>
      </h1>
      <p class="reveal-load [--step:3] mt-5 max-w-[54ch] text-lead text-mist">
        Every listing is RERA-checked and comes with an itemised price breakup, so the number you see
        is the number you pay. One advisor stays with you till registry.
      </p>
      <div class="reveal-load [--step:4] mt-7 grid gap-3 sm:flex">
        <Button href="#enquire" size="lg">Get the price sheet</Button>
        <Button href={whatsappUrl()} variant="whatsapp" icon="chat" size="lg" target="_blank" rel="noopener">
          Chat on WhatsApp
        </Button>
      </div>
      <ul class="reveal-load [--step:5] mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-5 text-small font-medium text-alabaster/85" aria-label="Why buyers choose us">
        {trust.map((t) => <li class="flex items-center gap-2"><Ring />{t}</li>)}
      </ul>
    </div>

    <figure class="reveal-load [--step:5] relative mx-auto w-full max-w-[26rem] lg:mr-0" aria-labelledby="sheet-caption">
      <div class="rounded-t-card border border-b-0 border-line bg-surface px-6 pt-6 pb-4 shadow-raise">
        <div class="flex items-baseline justify-between gap-4 border-b border-edge pb-3">
          <p class="font-display text-h4 font-medium">Price sheet</p>
          <p class="text-small text-mist">before your site visit</p>
        </div>
        <ul class="divide-y divide-line">
          {
            sheet.map((row) => (
              <li class="flex items-center justify-between gap-4 py-2.5">
                <span>
                  <span class="block font-medium">{row.item}</span>
                  {row.note && <span class="block text-small text-mist">{row.note}</span>}
                </span>
                <span class="grid size-6 shrink-0 place-items-center rounded-full border border-champagne/40 text-champagne">
                  <Icon name="check" size={15} />
                  <span class="sr-only">included</span>
                </span>
              </li>
            ))
          }
        </ul>
        <div class="mt-1 flex items-baseline justify-between gap-4 border-t border-edge pt-3">
          <p class="font-display text-lead font-medium">Total you pay</p>
          <p class="font-medium text-champagne">One number, in writing</p>
        </div>
      </div>
      <!-- Torn receipt edge -->
      <svg aria-hidden="true" viewBox="0 0 416 12" preserveAspectRatio="none" class="block h-3 w-full drop-shadow-[0_8px_8px_rgb(0_0_0/0.5)]">
        <path d="M0 0H416V2L408 12 400 2 392 12 384 2 376 12 368 2 360 12 352 2 344 12 336 2 328 12 320 2 312 12 304 2 296 12 288 2 280 12 272 2 264 12 256 2 248 12 240 2 232 12 224 2 216 12 208 2 200 12 192 2 184 12 176 2 168 12 160 2 152 12 144 2 136 12 128 2 120 12 112 2 104 12 96 2 88 12 80 2 72 12 64 2 56 12 48 2 40 12 32 2 24 12 16 2 8 12 0 2Z" class="fill-surface stroke-line" stroke-width="1"></path>
      </svg>
      <figcaption id="sheet-caption" class="mt-3 text-center text-small text-mist">
        What every price sheet from us itemises. No asterisks.
      </figcaption>
    </figure>
  </section>

  <!-- Projects -->
  {
    showcase.length > 0 && (
      <section aria-labelledby="projects-title" class:list={[section, 'pb-16 md:pb-24']}>
        <SectionHeading
          id="projects-title"
          title={latest ? 'More projects' : 'Latest projects'}
          intro="Each carries its UP RERA number, and each price says what it includes."
          link={{ label: 'See all projects', href: '/projects' }}
        />
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {showcase.map((p) => <ProjectCard project={p} class="reveal-scroll" />)}
        </div>
      </section>
    )
  }

  <!-- Browse by budget or type: heading in a narrow left column, the choices as ruled rows on the right. -->
  {
    tiles.length > 1 && (
      <section aria-labelledby="browse-title" class:list={[section, 'pb-16 md:pb-28']}>
        <div class="grid gap-8 border-t border-line pt-10 md:pt-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.75fr)] lg:gap-20">
          <h2 id="browse-title" class="text-h3 md:text-h2">Browse by budget or type</h2>
          <ul class="border-t border-line lg:border-t-0">
            {tiles.map((t) => (
              <li class="border-b border-line">
                <a href={t.href} class="group flex min-h-16 items-baseline justify-between gap-6 py-4 transition-colors hover:text-champagne">
                  <span class="text-lead font-medium">{t.label}</span>
                  <span class="figures shrink-0 text-small text-mist group-hover:text-champagne">
                    {t.count} {t.count === 1 ? 'project' : 'projects'}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Promises: the argument stays pinned on the left while the four promises scroll past on the right. -->
  <section aria-labelledby="promises-title" class="border-y border-line bg-surface/40 py-16 md:py-28">
    <div class:list={[section, 'grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.75fr)] lg:gap-20']}>
      <div class="flex flex-col gap-4 lg:sticky lg:top-28 lg:self-start">
        <h2 id="promises-title" class="text-h3 md:text-h2">Why buyers stay with us</h2>
        <p class="max-w-[44ch] text-lead text-mist">
          NCR buyers have learned to distrust brokers. These are the four things we do differently,
          and you can hold us to each one.
        </p>
        <a href="/about" class="inline-flex min-h-tap w-fit items-center font-medium text-champagne underline decoration-1 underline-offset-[6px] hover:text-alabaster">
          How we work
        </a>
      </div>
      <ul class="grid gap-x-12 sm:grid-cols-2">
        {
          promises.map((p) => (
            <li class="flex flex-col gap-3 border-t border-line py-8">
              <Ring class="size-4" />
              <h3 class="text-h4">{p.title}</h3>
              <p class="max-w-[46ch] text-mist">{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Founder -->
  <section aria-labelledby="founder-title" class:list={[section, 'py-16 md:py-28']}>
    <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-center md:gap-10">
      <span aria-hidden="true" class="grid size-20 place-items-center rounded-full border border-champagne/50 font-display text-h3 font-medium text-champagne md:size-28 md:text-h2">
        {site.founder.name.split(' ').filter((_, i, a) => i === 0 || i === a.length - 1).map((w) => w[0]).join('')}
      </span>
      <div class="max-w-[52rem]">
        <h2 id="founder-title" class="text-h3 md:text-h1">Never show a buyer a project we haven't checked.</h2>
        <p class="mt-4 max-w-[60ch] text-lead text-mist">
          That's the rule {site.founder.name} started {site.name} with. Today the Property Dealing
          Team works across Noida and Greater Noida, and the person who shows you a project is the
          person who helps with your loan, paperwork and registry.
        </p>
        <a href="/about" class="mt-4 inline-flex min-h-tap items-center font-medium text-champagne underline decoration-1 underline-offset-[6px] hover:text-alabaster">
          Read our story
        </a>
      </div>
    </div>
  </section>

  <EnquirySection />
</BaseLayout>
