---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Ring from '../components/Ring.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EnquirySection from '../components/EnquirySection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { promises } from '../lib/brand-content';
import { formatDate } from '../lib/format';
import PriceTag from '../components/PriceTag.astro';
import {
  areaSummary,
  configurationSummary,
  priceLabel,
  projectUrl,
  toListingItem,
} from '../lib/project';
import { BUDGETS, DEFAULT_SORT, matches, type FilterState } from '../lib/project-filters';
import { projectWhatsappMessage, whatsappUrl } from '../lib/whatsapp';

const published = (await getCollection('projects', ({ data }) => data.published)).map((e) => e.data);

const newestFirst = [...published].sort((a, b) => b.listedAt.getTime() - a.listedAt.getTime());

// The spotlight at the top of the page: the newest *featured* RERA-registered project, or if none
// is featured, the newest RERA-registered one. Projects with RERA only "applied for" aren't promoted.
const registered = newestFirst.filter((p) => p.reraStatus === 'registered');
const latest = registered.find((p) => p.featured) ?? registered[0];
const latestArea = latest && `${latest.location.sector}, ${latest.location.city}`;

// The grid below: everything else, newest first, three cards at most.
const showcase = newestFirst.filter((p) => p !== latest).slice(0, 3);

// "Browse by" tiles, counted with the same rules as the /projects filters. Empty ones are hidden.
const items = published.map(toListingItem);
const none: FilterState = { location: '', type: '', status: '', bhk: '', budget: '', sort: DEFAULT_SORT };
const tiles = [
  ...BUDGETS.map((b) => ({ label: b.label, state: { ...none, budget: b.value } })),
  { label: 'Homes', state: { ...none, type: 'residential' } },
  { label: 'Shops, offices and studios', state: { ...none, type: 'commercial' } },
  { label: 'Ready to move', state: { ...none, status: 'ready-to-move' } },
  { label: 'New launches', state: { ...none, status: 'upcoming' } },
]
  .map((t) => {
    const params = new URLSearchParams(
      Object.entries(t.state).filter(([k, v]) => v && k !== 'sort') as [string, string][],
    );
    return { ...t, href: `/projects?${params}`, count: items.filter((i) => matches(i, t.state)).length };
  })
  .filter((t) => t.count > 0);

// The price-sheet "receipt": every line we itemise before a site visit (brand book, Pillar 2).
const sheet = [
  { item: 'Basic sale price (BSP)', note: 'per sq. ft. × area' },
  { item: 'Preferred location charge', note: 'floor, facing, corner' },
  { item: 'IFMS', note: 'one-time maintenance deposit' },
  { item: 'Car parking', note: '' },
  { item: 'Club membership', note: '' },
  { item: 'GST', note: '' },
  { item: 'Stamp duty and registry', note: '' },
];

const trust = ['RERA-certified advisor', 'All-inclusive pricing', 'One advisor till registry', 'No spam calls'];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    name: site.name,
    url: site.url,
    slogan: site.tagline,
    telephone: site.phone,
    email: site.email,
    address: { '@type': 'PostalAddress', addressLocality: 'Noida', postalCode: '201307', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
    areaServed: ['Noida', 'Greater Noida'],
    founder: { '@type': 'Person', name: site.founder.name },
    sameAs: site.social.map((s) => s.href),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url },
];

const section = 'mx-auto max-w-site px-4 sm:px-6';
---

<BaseLayout
  title="Verified projects in Noida and Greater Noida"
  description="RERA-checked residential and commercial projects in Noida and Greater Noida, each with an itemised price sheet before your site visit, and one advisor till registry."
  jsonLd={jsonLd}
>
  <!-- Just listed: the newest RERA-registered project, first thing on the page. -->
  {
    latest && latestArea && (
      <section aria-labelledby="latest-title" class="border-b border-line bg-sand/60">
        <div class:list={[section, 'grid gap-6 py-6 md:py-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-center lg:gap-12']}>
          <a href={projectUrl(latest.slug)} tabindex="-1" aria-hidden="true" class="relative block overflow-hidden rounded-card bg-sand">
            <Image
              src={latest.images.hero.src}
              alt={latest.images.hero.alt}
              width={1200}
              height={750}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1200px) 640px, (min-width: 1024px) 54vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="aspect-[16/10] w-full object-cover"
            />
            {latest.images.hero.caption && (
              <span class="absolute bottom-3 left-3 max-w-[85%] rounded-badge bg-paper/90 px-2 py-0.5 text-small text-stone">
                {latest.images.hero.caption}
              </span>
            )}
          </a>
          <div class="flex flex-col gap-3">
            <p class="flex items-center gap-2 font-display text-small font-bold text-deep">
              <span aria-hidden="true" class="size-2 rounded-full bg-sun" />
              {latest.featured ? 'Featured project' : `Just listed on ${formatDate(latest.listedAt)}`}
            </p>
            <div>
              <p class="font-display text-lead font-extrabold text-stone">{latest.developer}</p>
              <h2 id="latest-title" class="text-h3 font-extrabold md:text-h2">
                <a href={projectUrl(latest.slug)} class="hover:text-deep hover:underline">{latest.name}</a>
              </h2>
            </div>
            <p class="text-lead text-stone">{latestArea}</p>
            <div class="flex flex-wrap gap-1.5">
              <Badge category={latest.type} />
              <Badge status={latest.status} />
            </div>
            <ul class="flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem]">
              <li>{configurationSummary(latest.configurations)}</li>
              <li class="tabular-nums">
                {areaSummary(latest.configurations).label === 'Area'
                  ? 'Area on request'
                  : `${areaSummary(latest.configurations).value} ${areaSummary(latest.configurations).label.toLowerCase()}`}
              </li>
            </ul>
            <PriceTag
              min={latest.priceRange.min}
              max={latest.priceRange.max}
              from={latest.priceRange.max === undefined}
              note={priceLabel(latest)}
              size="lg"
            />
            <p class="flex items-center gap-1.5 text-small text-stone">
              <Ring />
              <span>UP RERA <span class="tabular-nums">{latest.reraNumber}</span></span>
            </p>
            <div class="mt-2 grid grid-cols-2 gap-2 sm:flex">
              <Button href={projectUrl(latest.slug)} size="lg">View details</Button>
              <Button
                href={whatsappUrl(projectWhatsappMessage(latest.name, latestArea))}
                variant="whatsapp"
                icon="chat"
                size="lg"
                target="_blank"
                rel="noopener"
              >
                WhatsApp
              </Button>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Hero: the promise on the left, the price sheet it refers to on the right. -->
  <section aria-labelledby="hero-title" class:list={[section, 'grid items-center gap-10 pt-10 pb-14 md:pt-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16 lg:pb-20']}>
    <div>
      <h1 id="hero-title" class="text-h2 font-extrabold md:text-h1">
        Verified projects in Noida and Greater Noida.
        <span class="block">Full price, upfront.</span>
      </h1>
      <p class="mt-5 max-w-[54ch] text-lead text-stone">
        Every listing is RERA-checked and comes with an itemised price breakup, so the number you see
        is the number you pay. One advisor stays with you till registry.
      </p>
      <div class="mt-7 grid gap-3 sm:flex">
        <Button href="#enquire" size="lg">Get the price sheet</Button>
        <Button href={whatsappUrl()} variant="whatsapp" icon="chat" size="lg" target="_blank" rel="noopener">
          Chat on WhatsApp
        </Button>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-display text-small font-bold" aria-label="Why buyers choose us">
        {trust.map((t) => <li class="flex items-center gap-2"><Ring />{t}</li>)}
      </ul>
    </div>

    <figure class="relative mx-auto w-full max-w-[26rem] lg:mr-0" aria-labelledby="sheet-caption">
      <div class="rounded-t-card border border-b-0 border-line bg-white px-6 pt-6 pb-4 shadow-raise">
        <div class="flex items-baseline justify-between gap-4 border-b-2 border-ink pb-3">
          <p class="font-display text-lead font-extrabold">Price sheet</p>
          <p class="text-small text-stone">before your site visit</p>
        </div>
        <ul class="divide-y divide-dashed divide-line">
          {
            sheet.map((row) => (
              <li class="flex items-center justify-between gap-4 py-2.5">
                <span>
                  <span class="block font-medium">{row.item}</span>
                  {row.note && <span class="block text-small text-stone">{row.note}</span>}
                </span>
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-neem/10 text-neem">
                  <Icon name="check" size={15} />
                  <span class="sr-only">included</span>
                </span>
              </li>
            ))
          }
        </ul>
        <div class="mt-1 flex items-baseline justify-between gap-4 border-t-2 border-ink pt-3">
          <p class="font-display font-extrabold">Total you pay</p>
          <p class="font-display font-extrabold text-deep">One number, in writing</p>
        </div>
      </div>
      <!-- Torn receipt edge -->
      <svg aria-hidden="true" viewBox="0 0 416 12" preserveAspectRatio="none" class="block h-3 w-full drop-shadow-[0_6px_6px_rgb(28_27_25/0.08)]">
        <path d="M0 0H416V2L408 12 400 2 392 12 384 2 376 12 368 2 360 12 352 2 344 12 336 2 328 12 320 2 312 12 304 2 296 12 288 2 280 12 272 2 264 12 256 2 248 12 240 2 232 12 224 2 216 12 208 2 200 12 192 2 184 12 176 2 168 12 160 2 152 12 144 2 136 12 128 2 120 12 112 2 104 12 96 2 88 12 80 2 72 12 64 2 56 12 48 2 40 12 32 2 24 12 16 2 8 12 0 2Z" class="fill-white stroke-line" stroke-width="1"></path>
      </svg>
      <figcaption id="sheet-caption" class="mt-3 text-center text-small text-stone">
        What every price sheet from us itemises. No asterisks.
      </figcaption>
    </figure>
  </section>

  <!-- Projects -->
  {
    showcase.length > 0 && (
      <section aria-labelledby="projects-title" class:list={[section, 'pb-16 md:pb-24']}>
        <SectionHeading
          id="projects-title"
          title={latest ? 'More projects' : 'Latest projects'}
          intro="Each carries its UP RERA number, and each price says what it includes."
          link={{ label: 'See all projects', href: '/projects' }}
        />
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {showcase.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>
    )
  }

  <!-- Browse by budget or type -->
  {
    tiles.length > 1 && (
      <section aria-labelledby="browse-title" class:list={[section, 'pb-16 md:pb-24']}>
        <SectionHeading id="browse-title" title="Browse by budget or type" />
        <ul class:list={['mt-6 grid grid-cols-2 gap-3', tiles.length % 3 === 0 ? 'md:grid-cols-3' : 'md:grid-cols-4']}>
          {tiles.map((t) => (
            <li>
              <a href={t.href} class="flex h-full min-h-24 flex-col justify-between gap-2 rounded-card border border-line bg-white p-4 hover:border-ink">
                <span class="font-display text-lead leading-snug font-bold">{t.label}</span>
                <span class="text-small text-stone">{t.count} {t.count === 1 ? 'project' : 'projects'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Promises -->
  <section aria-labelledby="promises-title" class="bg-sand py-16 md:py-24">
    <div class={section}>
      <SectionHeading
        id="promises-title"
        title="Why buyers stay with us"
        intro="NCR buyers have learned to distrust brokers. These are the four things we do differently, and you can hold us to each one."
        link={{ label: 'How we work', href: '/about' }}
      />
      <ul class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {
          promises.map((p) => (
            <li class="flex gap-4">
              <Ring class="mt-2 size-5 border-[3px]" />
              <div>
                <h3 class="font-display text-h4 font-bold">{p.title}</h3>
                <p class="mt-2 max-w-[52ch] text-stone">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Founder -->
  <section aria-labelledby="founder-title" class:list={[section, 'py-16 md:py-24']}>
    <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-center md:gap-10">
      <span aria-hidden="true" class="grid size-20 place-items-center rounded-full bg-ink font-display text-h4 font-extrabold text-paper md:size-28 md:text-h3">
        {site.founder.name.split(' ').filter((_, i, a) => i === 0 || i === a.length - 1).map((w) => w[0]).join('')}
      </span>
      <div class="max-w-[52rem]">
        <h2 id="founder-title" class="text-h3 font-extrabold md:text-h2">Never show a buyer a project we haven't checked.</h2>
        <p class="mt-4 max-w-[60ch] text-lead text-stone">
          That's the rule {site.founder.name} started {site.name} with. Today the Property Dealing
          Team works across Noida and Greater Noida, and the person who shows you a project is the
          person who helps with your loan, paperwork and registry.
        </p>
        <a href="/about" class="mt-4 inline-flex min-h-tap items-center font-display font-bold text-deep underline decoration-2 underline-offset-4 hover:text-ink">
          Read our story
        </a>
      </div>
    </div>
  </section>

  <EnquirySection />
</BaseLayout>
