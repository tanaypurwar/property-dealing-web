---
import EnquirySection from '../components/EnquirySection.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${site.name}`,
    url: new URL('/contact/', Astro.site ?? site.url).href,
    mainEntity: {
      '@type': 'RealEstateAgent',
      name: site.name,
      url: site.url,
      telephone: site.phone,
      email: site.email,
      address: { '@type': 'PostalAddress', addressLocality: 'Noida', postalCode: '201307', addressRegion: 'Uttar Pradesh', addressCountry: 'IN' },
      sameAs: site.social.map((s) => s.href),
    },
  },
];
---

<BaseLayout
  title="Contact us"
  description={`Call ${site.phoneDisplay}, chat on WhatsApp or send your budget and preferred area. We reply with verified projects and the full price breakup.`}
  jsonLd={jsonLd}
  floatingWhatsApp={false}
>
  <EnquirySection as="h1">
    <li>
      <a href={`mailto:${site.email}`} class="inline-flex min-h-tap items-center gap-3 break-all hover:text-sun">
        <Icon name="mail" size={20} />{site.email}
      </a>
    </li>
    <li class="flex min-h-tap items-center gap-3 text-paper/80"><Icon name="pin" size={20} />{site.address}</li>
    <li class="mt-4 flex flex-wrap gap-x-5 border-t border-paper/15 pt-4">
      {
        site.social.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" class="inline-flex min-h-tap items-center text-paper/80 hover:text-sun hover:underline">
            {s.label}
          </a>
        ))
      }
    </li>
  </EnquirySection>
</BaseLayout>
