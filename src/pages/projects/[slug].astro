---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import PriceTag from '../../components/PriceTag.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Ring from '../../components/Ring.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BrochureGate from '../../components/forms/BrochureGate.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import FloorPlans from '../../components/media/FloorPlans.astro';
import HeroCarousel from '../../components/media/HeroCarousel.astro';
import Lightbox from '../../components/media/Lightbox.astro';
import MapEmbed from '../../components/media/MapEmbed.astro';
import VideoEmbed from '../../components/media/VideoEmbed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import { formatMonth, formatPrice, formatPriceRange } from '../../lib/format';
import { areaSummary, configurationSummary, priceLabel, reraText, unitArea } from '../../lib/project';
import { STATUS_LABELS } from '../../lib/project-filters';
import { amenityIcon, formatNearby, groupNearby, similarProjects, youtubeId } from '../../lib/project-details';
import { projectWhatsappMessage } from '../../lib/whatsapp';

export const getStaticPaths = (async () => {
  // In `astro dev`, drafts get pages too so they can be reviewed; builds only include published ones.
  const entries = await getCollection('projects', ({ data }) => data.published || import.meta.env.DEV);
  const all = entries.filter((e) => e.data.published).map((e) => e.data);
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry, similar: similarProjects(entry.data, all) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<'projects'>;
  similar: CollectionEntry<'projects'>['data'][];
}

const { entry, similar } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);

const area = `${p.location.sector}, ${p.location.city}`;
const shortArea = p.location.sector.includes(p.location.city) ? p.location.sector : area;
const configs = configurationSummary(p.configurations);
const price =
  p.priceRange.max === undefined
    ? `from ${formatPrice(p.priceRange.min)}`
    : formatPriceRange(p.priceRange.min, p.priceRange.max);
const videoId = p.video ? youtubeId(p.video) : undefined;
const nearby = groupNearby(p.nearby);
const indian = new Intl.NumberFormat('en-IN');
// Same as the layout's canonical, which follows Astro's trailing-slash output.
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;

const possession = p.possessionDate
  ? p.status === 'ready-to-move'
    ? `Ready since ${formatMonth(p.possessionDate)}`
    : formatMonth(p.possessionDate)
  : undefined;

const facts: { icon: IconName; label: string; value: string }[] = [
  { icon: 'home', label: 'Configurations', value: configs },
  { icon: 'area', ...areaSummary(p.configurations) },
  ...(possession ? [{ icon: 'calendar' as const, label: 'Possession', value: possession }] : []),
  ...(p.landAreaAcres ? [{ icon: 'leaf' as const, label: 'Land area', value: `${p.landAreaAcres} acres` }] : []),
  ...(p.totalUnits ? [{ icon: 'units' as const, label: 'Total units', value: indian.format(p.totalUnits) }] : []),
  ...(p.towers ? [{ icon: 'building' as const, label: 'Towers', value: String(p.towers) }] : []),
  { icon: 'shield', label: p.reraStatus === 'registered' ? 'UP RERA no.' : 'UP RERA', value: reraText(p) },
];

const threeCol = facts.length % 3 === 0;

const areaHeader = p.configurations.every((c) => c.carpetArea)
  ? 'Carpet area'
  : p.configurations.every((c) => !c.carpetArea && c.saleableArea)
    ? 'Saleable area'
    : 'Area';
const allInclusive = p.priceBasis === 'all-inclusive';

const slides = [
  { src: p.images.hero.src, alt: p.images.hero.alt },
  ...p.images.gallery.map((g) => ({ src: g.src, alt: g.caption, caption: g.caption })),
];

// SEO
const title = `${p.name}, ${shortArea}: ${configs} price${p.images.floorPlans.length > 0 ? ' and floor plans' : ' and details'}`;
const description = `${p.name} in ${area}: ${configs}, ${price} ${priceLabel(p)}. ${STATUS_LABELS[p.status]}. UP RERA ${p.reraStatus === 'registered' ? p.reraNumber : 'applied for'}. ${p.images.floorPlans.length > 0 ? 'Floor plans, amenities' : 'Amenities, location'} and price sheet.`;
const ogImage = new URL(
  (await getImage({ src: p.images.hero.src, width: 1200, height: 630, format: 'jpg', fit: 'cover' })).src,
  Astro.site ?? site.url,
).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateListing',
    name: `${p.name}, ${area}`,
    description: p.tagline,
    url: canonical,
    image: ogImage,
    datePosted: p.listedAt.toISOString().slice(0, 10),
    provider: { '@type': 'RealEstateAgent', name: site.name, url: site.url, telephone: site.phone },
    mainEntity: {
      // Typed as Product too, so the price range can be expressed as an offer.
      '@type': [p.type === 'residential' ? 'ApartmentComplex' : 'Place', 'Product'],
      name: p.name,
      description: p.tagline,
      image: ogImage,
      brand: { '@type': 'Organization', name: p.developer },
      address: {
        '@type': 'PostalAddress',
        streetAddress: p.location.address,
        addressLocality: p.location.city,
        addressRegion: 'Uttar Pradesh',
        addressCountry: 'IN',
      },
      ...(p.location.latitude !== undefined && {
        geo: { '@type': 'GeoCoordinates', latitude: p.location.latitude, longitude: p.location.longitude },
      }),
      amenityFeature: p.amenities.map((a) => ({ '@type': 'LocationFeatureSpecification', name: a, value: true })),
      ...(p.type === 'residential' && p.totalUnits && { numberOfAccommodationUnits: p.totalUnits }),
      offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'INR',
        lowPrice: p.priceRange.min,
        ...(p.priceRange.max !== undefined && { highPrice: p.priceRange.max }),
        offerCount: p.configurations.length,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? site.url).href },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects/', Astro.site ?? site.url).href },
      { '@type': 'ListItem', position: 3, name: p.name, item: canonical },
    ],
  },
];

const section = 'scroll-mt-24';
---

<BaseLayout
  title={title}
  description={description}
  image={p.images.hero.src}
  imageAlt={p.images.hero.alt}
  jsonLd={jsonLd}
  whatsappMessage={projectWhatsappMessage(p.name, area)}
  floatingWhatsApp={false}
  noindex={!p.published}
>
  <div class="mx-auto max-w-site md:px-6">
    <nav aria-label="Breadcrumb" class="px-4 py-2 md:px-0">
      <ol class="flex flex-wrap items-center gap-x-1 text-small text-stone">
        <li><a href="/" class="inline-flex min-h-tap items-center hover:text-deep hover:underline">Home</a></li>
        <li aria-hidden="true"><Icon name="chevronRight" size={14} /></li>
        <li><a href="/projects" class="inline-flex min-h-tap items-center hover:text-deep hover:underline">Projects</a></li>
        <li aria-hidden="true"><Icon name="chevronRight" size={14} /></li>
        <li aria-current="page" class="font-medium text-ink">{p.name}</li>
      </ol>
    </nav>

    {
      !p.published && (
        <p role="note" class="mx-4 mb-3 rounded-control border-2 border-dashed border-deep bg-paper px-4 py-3 font-medium text-ink md:mx-0">
          Draft preview. This page only exists in <code>astro dev</code> and won't be published until{' '}
          <code>published: true</code> is set, which needs a real UP RERA number.
        </p>
      )
    }

    <!-- 1. Hero -->
    <HeroCarousel label={`${p.name} images`} slides={slides} />
  </div>

  <div class="mx-auto max-w-site px-4 sm:px-6">
    <header class="flex flex-col gap-5 pt-5 md:flex-row md:items-end md:justify-between md:gap-10 md:pt-8">
      <div class="flex flex-col gap-2">
        <div class="flex flex-wrap gap-1.5">
          <Badge category={p.type} />
          <Badge status={p.status} />
        </div>
        <h1 class="text-h2 font-extrabold md:text-h1">{p.name}</h1>
        <p class="flex items-start gap-1.5 text-lead text-stone">
          <Icon name="pin" size={20} class="mt-1.5" />
          <span>{area} <span class="text-stone/80">by {p.developer}</span></span>
        </p>
      </div>
      <div class="flex flex-col gap-3 md:items-end md:text-right">
        <PriceTag
          min={p.priceRange.min}
          max={p.priceRange.max}
          from={p.priceRange.max === undefined}
          note={priceLabel(p)}
          size="lg"
          class="md:justify-end"
        />
        {p.priceNote && <p class="max-w-[42ch] text-small text-stone">{p.priceNote}</p>}
        <div class="grid grid-cols-2 gap-2 sm:flex">
          <Button href="#enquire" size="lg">Enquire now</Button>
          {
            p.brochure &&
              (p.brochureGated ? (
                <Button href={p.brochure} variant="secondary" size="lg" icon="download" data-brochure-open>
                  Brochure
                </Button>
              ) : (
                <Button href={p.brochure} variant="secondary" size="lg" icon="download" download>
                  Brochure
                </Button>
              ))
          }
        </div>
      </div>
    </header>

    {
      p.reraStatus === 'applied' && (
        <div role="note" class="mt-6 flex gap-3 rounded-card border-2 border-deep bg-paper p-4 sm:p-5">
          <Icon name="shield" size={22} class="mt-0.5 text-deep" />
          <div>
            <p class="font-display font-bold text-ink">RERA registration applied for, not yet granted</p>
            <p class="mt-1 text-stone">
              The details below come from the developer's marketing partners and may change. We don't
              take bookings or EOI payments for a project until it is registered on{' '}
              <a href="https://up-rera.in" target="_blank" rel="noopener" class="font-medium text-deep underline">up-rera.in</a>.
              Register your interest and we'll tell you as soon as it is.
            </p>
          </div>
        </div>
      )
    }

    <!-- 2. Quick facts -->
    <!--
      Facts vary per project (4 to 6). Desktop: one row, equal columns. Smaller screens: 3 columns
      when that fills evenly, otherwise 2, where the RERA number takes a full row and the fact
      before it widens if it would otherwise sit alone.
    -->
    <dl
      class:list={[
        'mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-card border border-line bg-line lg:grid-flow-col lg:auto-cols-fr lg:grid-cols-none',
        threeCol && 'sm:grid-cols-3',
      ]}
      aria-label="Quick facts"
    >
      {
        facts.map((f, i) => (
          <div
            class:list={[
              'flex flex-col gap-1 bg-white p-4',
              (f.icon === 'shield' || (i === facts.length - 2 && facts.length % 2 === 0)) &&
                (threeCol ? 'max-sm:col-span-2' : 'max-lg:col-span-2'),
            ]}
          >
            <dt class="flex items-center gap-1.5 font-display text-small font-bold text-stone">
              <Icon name={f.icon} size={16} />
              {f.label}
            </dt>
            <dd class="font-display font-bold break-words text-ink tabular-nums">{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_23rem] lg:gap-10 md:mt-16">
      <div class="flex min-w-0 flex-col gap-14 md:gap-20 lg:col-start-1 lg:row-start-1">
        <!-- 3. Overview -->
        <section id="overview" aria-labelledby="overview-title" class={section}>
          <h2 id="overview-title" class="text-h3 font-extrabold md:text-h2">Overview</h2>
          <p class="mt-2 text-lead text-stone">{p.tagline}</p>
          <div class="mt-5 max-w-[68ch] [&_a]:text-deep [&_a]:underline [&>*+*]:mt-4 [&_h3]:mt-8 [&_h3]:text-h4 [&_h3]:font-bold [&_li]:ml-5 [&_li]:list-disc [&_table]:w-full [&_table]:text-left [&_td]:border-b [&_td]:border-line [&_td]:py-2 [&_td]:pr-3 [&_td:last-child]:text-right [&_td:last-child]:tabular-nums [&_th]:border-b-2 [&_th]:border-ink [&_th]:py-2 [&_th]:pr-3 [&_th]:font-display [&_th]:text-small [&_th]:text-stone [&_th:last-child]:text-right">
            <Content />
          </div>
          <ul class="mt-8 grid gap-3 sm:grid-cols-2">
            {
              p.highlights.map((h) => (
                <li class="flex items-start gap-3 rounded-card bg-sand p-4">
                  <Ring class="mt-1.5 size-4 border-[3px]" />
                  <span class="font-medium">{h}</span>
                </li>
              ))
            }
          </ul>
          <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-small">
            <div class="flex gap-1.5"><dt class="text-stone">Developer</dt><dd class="font-medium">{p.developer}</dd></div>
            {p.landAreaAcres && <div class="flex gap-1.5"><dt class="text-stone">Land area</dt><dd class="font-medium tabular-nums">{p.landAreaAcres} acres</dd></div>}
            {p.floors && <div class="flex gap-1.5"><dt class="text-stone">Tallest tower</dt><dd class="font-medium tabular-nums">{p.floors} floors</dd></div>}
          </dl>
        </section>

        <!-- 4. Configurations and pricing -->
        <section id="pricing" aria-labelledby="pricing-title" class={section}>
          <SectionHeading
            id="pricing-title"
            title="Configurations and prices"
            intro={
              allInclusive
                ? 'All-inclusive: PLC, IFMS, parking and registry are in these figures. Ask for the itemised sheet for any unit.'
                : `${p.priceNote ?? ''} Ask us for the all-inclusive sheet for any unit.`
            }
          />
          <table class="mt-6 w-full border-collapse text-left">
            <caption class="sr-only">Prices for each configuration at {p.name}</caption>
            <thead class="max-md:sr-only">
              <tr class="border-b-2 border-ink font-display text-small text-stone">
                <th scope="col" class="py-3 pr-4 font-bold">Unit type</th>
                <th scope="col" class="py-3 pr-4 font-bold">{areaHeader}</th>
                <th scope="col" class="py-3 pr-4 font-bold">{allInclusive ? 'Price, all-inclusive' : p.priceBasis === 'base' ? 'Price (BSP)' : 'Starting price'}</th>
                <th scope="col" class="py-3"><span class="sr-only">Action</span></th>
              </tr>
            </thead>
            <tbody class="max-md:flex max-md:flex-col max-md:gap-3">
              {
                p.configurations.map((c) => (
                  <tr class="border-line max-md:grid max-md:grid-cols-2 max-md:gap-x-4 max-md:gap-y-2 max-md:rounded-card max-md:border max-md:bg-white max-md:p-4 md:border-b">
                    <th scope="row" class="py-4 pr-4 font-display text-lead font-extrabold max-md:col-span-2 max-md:py-0">
                      {c.type}
                    </th>
                    <td class="py-4 pr-4 tabular-nums max-md:py-0">
                      <span class:list={['block text-small text-stone', areaHeader !== 'Area' && 'md:hidden']}>
                        {unitArea(c).label}
                      </span>
                      {unitArea(c).value}
                    </td>
                    <td class="py-4 pr-4 font-display font-bold tabular-nums max-md:py-0">
                      <span class="block font-sans text-small font-normal text-stone md:hidden">Price</span>
                      {c.price ? formatPriceRange(c.price.min, c.price.max) : 'On request'}
                    </td>
                    <td class="py-3 text-right max-md:col-span-2 max-md:py-0 max-md:pt-1">
                      <Button
                        href="#enquire"
                        size="sm"
                        variant="secondary"
                        data-prefill-config={c.type}
                        class="max-md:w-full"
                        aria-label={`Get price details for ${c.type}`}
                      >
                        Get price details
                      </Button>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </section>

        <!-- 5. Floor plans -->
        {
          p.images.floorPlans.length > 0 && (
            <section id="floor-plans" aria-labelledby="plans-title" class={section}>
              <h2 id="plans-title" class="text-h3 font-extrabold md:text-h2">Floor plans</h2>
              <p class="mt-2 text-lead text-stone">Tap a plan to see it full size.</p>
              <div class="mt-6">
                <FloorPlans projectName={p.name} plans={p.images.floorPlans} />
              </div>
            </section>
          )
        }

        <!-- 6. Amenities -->
        {
          p.amenities.length > 0 && (
            <section id="amenities" aria-labelledby="amenities-title" class={section}>
              <h2 id="amenities-title" class="text-h3 font-extrabold md:text-h2">Amenities</h2>
              <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
                {p.amenities.map((a) => (
                  <li class="flex items-center gap-3 rounded-card border border-line bg-white p-3">
                    <span class="grid size-10 shrink-0 place-items-center rounded-control bg-sand text-ink">
                      <Icon name={amenityIcon(a)} size={20} />
                    </span>
                    <span class="text-[0.9375rem] leading-snug">{a}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- 7. Gallery -->
        {
          p.images.gallery.length > 0 && (
            <section id="gallery" aria-labelledby="gallery-title" class={section}>
              <h2 id="gallery-title" class="text-h3 font-extrabold md:text-h2">Gallery</h2>
              <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
                {p.images.gallery.map((g, i) => (
                  <li>
                    <button
                      type="button"
                      data-lightbox-open="gallery-viewer"
                      data-index={i}
                      class="group block w-full overflow-hidden rounded-card bg-sand text-left"
                    >
                      <Image
                        src={g.src}
                        alt={g.caption}
                        width={600}
                        height={375}
                        widths={[300, 600]}
                        sizes="(min-width: 1024px) 250px, 50vw"
                        class="aspect-[16/10] w-full object-cover transition-opacity group-hover:opacity-90"
                      />
                      <span class="block px-1 pt-2 text-small text-stone">{g.caption}</span>
                    </button>
                  </li>
                ))}
              </ul>
              <Lightbox id="gallery-viewer" label={`${p.name} gallery`} items={p.images.gallery.map((g) => ({ src: g.src, alt: g.caption, caption: g.caption }))} />
            </section>
          )
        }

        <!-- 8. Video -->
        {
          videoId && (
            <section id="video" aria-labelledby="video-title" class={section}>
              <h2 id="video-title" class="text-h3 font-extrabold md:text-h2">Video walkthrough</h2>
              <div class="mt-6">
                <VideoEmbed videoId={videoId} title={`${p.name} walkthrough`} poster={p.images.hero.src} />
              </div>
            </section>
          )
        }

        <!-- 9. Location -->
        <section id="location" aria-labelledby="location-title" class={section}>
          <h2 id="location-title" class="text-h3 font-extrabold md:text-h2">Location</h2>
          <p class="mt-2 text-lead text-stone">{p.location.address}</p>
          <div class="mt-6">
            <MapEmbed
              latitude={p.location.latitude}
              longitude={p.location.longitude}
              title={p.name}
              address={p.location.address}
            />
          </div>
          {
            nearby.length > 0 && (
              <div class="mt-8 grid gap-6 sm:grid-cols-2">
                {nearby.map((g) => (
                  <div>
                    <h3 class="flex items-center gap-2 font-display text-body font-bold">
                      <Icon name={g.icon} size={20} />
                      {g.label}
                    </h3>
                    <ul class="mt-2 divide-y divide-line border-y border-line">
                      {g.places.map((n) => (
                        <li class="flex items-baseline justify-between gap-4 py-2.5">
                          <span>{n.name}</span>
                          <span class="shrink-0 font-display font-bold tabular-nums">{formatNearby(n)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )
          }
        </section>
      </div>

      <!-- 10. Enquiry: sticky sidebar on desktop, in the page flow on mobile. -->
      <aside class="lg:col-start-2 lg:row-span-2 lg:row-start-1" aria-label="Enquiry">
        <div class="lg:sticky lg:top-24 lg:max-h-[calc(100dvh-7rem)] lg:overflow-y-auto lg:rounded-card">
          <EnquiryForm
            id="enquire"
            projectName={p.name}
            configurations={p.configurations.map((c) => c.type)}
            whatsappMessage={projectWhatsappMessage(p.name, area)}
            class="scroll-mt-24"
          />
        </div>
      </aside>

      <!-- 11. RERA -->
      <section
        id="rera"
        aria-labelledby="rera-title"
        class:list={[section, 'rounded-card bg-sand p-5 sm:p-6 lg:col-start-1 lg:row-start-2']}
      >
        <h2 id="rera-title" class="text-h4 font-extrabold">RERA registration</h2>
        <dl class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          <div>
            <dt class="text-small text-stone">Project UP RERA {p.reraStatus === 'registered' ? 'number' : 'status'}</dt>
            <dd class="flex items-center gap-2 font-display font-bold tabular-nums">
              {p.reraStatus === 'registered' ? <><Ring />{p.reraNumber}</> : <span class="text-deep">{reraText(p)}</span>}
            </dd>
          </div>
          <div>
            <dt class="text-small text-stone">Developer</dt>
            <dd class="font-display font-bold">{p.developer}</dd>
          </div>
          {
            possession && p.status !== 'ready-to-move' && (
              <div>
                <dt class="text-small text-stone">RERA possession date</dt>
                <dd class="font-display font-bold">{possession}</dd>
              </div>
            )
          }
          <div>
            <dt class="text-small text-stone">Our UP RERA agent registration</dt>
            <dd class="font-display font-bold tabular-nums">{site.agentRera}</dd>
          </div>
        </dl>
        <p class="mt-5 text-small text-stone">
          You can check this project's registration, approvals and quarterly progress on{' '}
          <a href="https://up-rera.in" target="_blank" rel="noopener" class="font-medium text-deep underline">up-rera.in</a>.
          Details on this page come from the developer and the RERA filing and can change; confirm
          them before you pay. Prices are all-inclusive unless stated. Images marked "artist's
          impression" are renders, not site photos.
        </p>
      </section>
    </div>

    <!-- 12. Similar projects -->
    {
      similar.length > 0 && (
        <section aria-labelledby="similar-title" class="mt-20 mb-16">
          <SectionHeading id="similar-title" title="Similar projects" link={{ label: 'See all projects', href: `/projects?type=${p.type}` }} />
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {similar.map((s) => <ProjectCard project={s} />)}
          </div>
        </section>
      )
    }
    {similar.length === 0 && <div class="mb-16"></div>}
  </div>

  {p.brochure && p.brochureGated && <BrochureGate href={p.brochure} projectName={p.name} />}
</BaseLayout>
