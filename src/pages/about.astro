---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Ring from '../components/Ring.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { whatsappUrl } from '../lib/whatsapp';
import qrFacebook from '../assets/social/qr-facebook.png';
import qrInstagram from '../assets/social/qr-instagram.png';
import qrWhatsapp from '../assets/social/qr-whatsapp-channel.png';
import qrYoutube from '../assets/social/qr-youtube.png';

// The four brand pillars (brand book, Part A), each answering a fear buyers have about brokers.
const promises: { title: string; body: string }[] = [
  {
    title: 'Verified before it’s listed',
    body: 'Our team visits the site, checks the RERA registration and confirms the developer’s approvals before a project reaches this website. If we haven’t checked it, we don’t show it.',
  },
  {
    title: 'The full price, first',
    body: 'You get an all-inclusive price breakup (BSP, PLC, IFMS, parking, club, GST, stamp duty and registry) before the site visit. The number you see is the number you pay.',
  },
  {
    title: 'One advisor, till registry',
    body: 'The person who shows you the project is the person who helps with the loan, the paperwork and the registry. No hand-offs to strangers.',
  },
  {
    title: 'Your time, your terms',
    body: 'No cold-call storms. You pick the call time, or talk to us on WhatsApp. We never pass your number to other brokers.',
  },
];

// A real sequence, so it's numbered.
const steps: { icon: IconName; title: string; body: string }[] = [
  { icon: 'chat', title: 'Tell us what you need', body: 'Budget, area and timeline, on a call at the time you pick or on WhatsApp.' },
  { icon: 'sheet', title: 'Get verified options', body: 'A shortlist that fits, each with its RERA number and an all-inclusive price sheet.' },
  { icon: 'pin', title: 'Visit the sites', body: 'Free site visits with your advisor, on the days that suit you.' },
  { icon: 'home', title: 'Book and finance', body: 'Help with the booking, payment plan and home loan, with every charge in writing.' },
  { icon: 'shield', title: 'Registry', body: 'Your advisor stays with you until the registry is done.' },
];

const socials = [
  { label: 'Instagram', handle: '@propertydealingteam', href: site.social[0].href, qr: qrInstagram },
  { label: 'YouTube', handle: '@propertydealingteam', href: site.social[1].href, qr: qrYoutube },
  { label: 'Facebook', handle: 'propertydealingteam', href: site.social[2].href, qr: qrFacebook },
  { label: 'WhatsApp channel', handle: 'Price and launch updates', href: site.social[3].href, qr: qrWhatsapp },
];

const developers = ['Godrej', 'Hero Homes', 'Nirala'];
const initials = site.founder.name
  .split(' ')
  .map((w) => w[0])
  .filter((_, i, a) => i === 0 || i === a.length - 1)
  .join('');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'RealEstateAgent',
    name: site.name,
    url: site.url,
    slogan: site.tagline,
    telephone: site.phone,
    email: site.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Noida',
      postalCode: '201307',
      addressRegion: 'Uttar Pradesh',
      addressCountry: 'IN',
    },
    areaServed: ['Noida', 'Greater Noida'],
    founder: { '@type': 'Person', name: site.founder.name },
    sameAs: site.social.map((s) => s.href),
  },
];

const section = 'mx-auto max-w-site px-4 sm:px-6';
---

<BaseLayout
  title="About us"
  description={`${site.name} is a RERA-certified property advisory in Noida and Greater Noida, founded by ${site.founder.name}. Verified projects, the full price upfront, and one advisor until registry.`}
  jsonLd={jsonLd}
>
  <!-- Intro -->
  <header class:list={[section, 'pt-10 pb-12 md:pt-16 md:pb-16']}>
    <p class="font-display text-lead font-bold text-deep">{site.tagline}</p>
    <h1 class="mt-3 max-w-[18ch] text-h2 font-extrabold md:text-h1">We check every project before you see it.</h1>
    <p class="mt-5 max-w-[60ch] text-lead text-stone">
      {site.name} is a RERA-certified property advisory in Noida and Greater Noida. Before a project
      reaches this website, our team visits the site, checks its UP RERA registration and prepares
      an all-inclusive price sheet. The number you see is the number you pay.
    </p>
  </header>

  <!-- Story + founder -->
  <section aria-labelledby="story-title" class:list={[section, 'grid gap-10 pb-16 md:pb-24 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16']}>
    <div class="max-w-[64ch]">
      <h2 id="story-title" class="text-h3 font-extrabold md:text-h2">How we started</h2>
      <div class="mt-5 flex flex-col gap-4 text-[1.0625rem] leading-relaxed">
        <p>
          {site.founder.name} started {site.name} four years ago with one rule: never show a buyer a
          project we haven't checked ourselves.
        </p>
        <p>
          Buyers in NCR have learned to distrust property brokers, and often for good reason: half
          quotes, hidden charges, and calls from numbers they never gave out. We set out to work the
          other way. Every project we list is personally verified and carries its RERA number, and
          every price comes with its breakup in writing.
        </p>
        <p>
          Today the Property Dealing Team works with developers including{' '}
          {developers.join(', ').replace(/, ([^,]*)$/, ' and $1')}{' '}
          across Noida and Greater Noida. Whether you're upgrading, investing or buying from abroad,
          one dedicated advisor stays with you from the first site visit to the registry.
        </p>
      </div>
    </div>

    <aside aria-label="Founder" class="self-start rounded-card border border-line bg-white p-6">
      <div class="flex items-center gap-4">
        <span
          aria-hidden="true"
          class="grid size-16 shrink-0 place-items-center rounded-full bg-ink font-display text-h4 font-extrabold text-paper"
        >
          {initials}
        </span>
        <div>
          <p class="font-display text-lead font-extrabold">{site.founder.name}</p>
          <p class="text-stone">{site.founder.role}, {site.name}</p>
        </div>
      </div>
      <p class="mt-4 flex items-center gap-2 text-small font-medium"><Ring />RERA-certified property advisor</p>
      <ul class="mt-4 border-t border-line pt-2">
        <li>
          <a href={`tel:${site.phone}`} class="flex min-h-tap items-center gap-3 font-display font-bold tabular-nums hover:text-deep">
            <Icon name="phone" size={18} />{site.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="flex min-h-tap items-center gap-3 break-all hover:text-deep">
            <Icon name="mail" size={18} />{site.email}
          </a>
        </li>
        <li class="flex min-h-tap items-center gap-3 text-stone"><Icon name="pin" size={18} />{site.address}</li>
      </ul>
      <Button href={whatsappUrl()} variant="whatsapp" icon="chat" block class="mt-4" target="_blank" rel="noopener">
        Chat on WhatsApp
      </Button>
    </aside>
  </section>

  <!-- Promises -->
  <section aria-labelledby="promises-title" class="bg-sand py-16 md:py-24">
    <div class={section}>
      <SectionHeading
        id="promises-title"
        title="What we promise"
        intro="Four things you can hold us to, each one in writing."
      />
      <ul class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
        {
          promises.map((p) => (
            <li class="flex gap-4">
              <Ring class="mt-2 size-5 border-[3px]" />
              <div>
                <h3 class="font-display text-h4 font-bold">{p.title}</h3>
                <p class="mt-2 max-w-[52ch] text-stone">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section aria-labelledby="process-title" class:list={[section, 'py-16 md:py-24']}>
    <SectionHeading id="process-title" title="From first call to registry" />
    <ol class="mt-10 grid gap-6 md:grid-cols-5 md:gap-4">
      {
        steps.map((s, i) => (
          <li class="relative flex gap-4 md:flex-col md:gap-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-full border-2 border-ink bg-paper font-display font-extrabold tabular-nums">
              {i + 1}
            </span>
            {i < steps.length - 1 && (
              <span aria-hidden="true" class="absolute top-11 bottom-[-1.5rem] left-[1.3rem] w-0.5 bg-line md:top-[1.3rem] md:right-[-1rem] md:bottom-auto md:left-14 md:h-0.5 md:w-auto" />
            )}
            <div>
              <h3 class="flex items-center gap-2 font-display text-body font-bold">
                <Icon name={s.icon} size={18} class="text-stone" />
                {s.title}
              </h3>
              <p class="mt-1 text-[0.9375rem] text-stone">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Follow -->
  <section aria-labelledby="follow-title" class:list={[section, 'pb-16 md:pb-24']}>
    <SectionHeading
      id="follow-title"
      title="Follow the team"
      intro="Site walkthroughs, price updates and new launches. On a computer? Scan a code with your phone."
    />
    <ul class="mt-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="group flex h-full flex-col gap-4 rounded-card border border-line bg-white p-4 hover:border-ink"
            >
              <Image
                src={s.qr}
                alt=""
                width={240}
                height={Math.round((240 * s.qr.height) / s.qr.width)}
                class="mx-auto hidden aspect-square w-full max-w-40 object-contain md:block"
              />
              <span class="flex flex-col">
                <span class="flex items-center gap-1.5 font-display font-bold group-hover:text-deep">
                  {s.label}
                  <Icon name="external" size={14} class="text-stone" />
                </span>
                <span class="text-small break-words text-stone">{s.handle}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- CTA -->
  <section aria-labelledby="cta-title" class="bg-ink text-paper">
    <div class:list={[section, 'flex flex-col items-start gap-6 py-14 md:flex-row md:items-center md:justify-between md:py-16']}>
      <div class="max-w-[46ch]">
        <h2 id="cta-title" class="text-h3 font-extrabold">Tell us your budget and preferred area.</h2>
        <p class="mt-2 text-paper/80">
          We'll send verified options with the full price breakup, and call only at the time you pick.
        </p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <Button href={whatsappUrl()} variant="whatsapp" icon="chat" size="lg" target="_blank" rel="noopener">
          Chat on WhatsApp
        </Button>
        <Button href={`tel:${site.phone}`} variant="inverse" icon="phone" size="lg">
          Call {site.phoneDisplay}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
