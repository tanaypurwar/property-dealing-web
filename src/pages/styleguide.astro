---
import { getCollection } from 'astro:content';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import PriceTag from '../components/PriceTag.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Ring from '../components/Ring.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SkylineRule from '../components/SkylineRule.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatArea, formatAreaRange, formatPrice, formatPriceRange } from '../lib/format';

// Cards use the sample projects in src/content/projects (placeholder data).
const samples = (await getCollection('projects')).map((e) => e.data);

const colours = [
  { name: 'Canvas', token: 'canvas', hex: '#0F0E0E', role: 'Page ground, text on champagne', swatch: 'bg-canvas', dark: true },
  { name: 'Surface', token: 'surface', hex: '#1C1917', role: 'Cards, panels, inputs', swatch: 'bg-surface', dark: true },
  { name: 'Raised', token: 'raised', hex: '#292524', role: 'Hover and pressed on surface', swatch: 'bg-raised', dark: true },
  { name: 'Alabaster', token: 'alabaster', hex: '#ECE6DC', role: 'Primary text', swatch: 'bg-alabaster', dark: false },
  { name: 'Mist', token: 'mist', hex: '#A8A29E', role: 'Secondary text, captions', swatch: 'bg-mist', dark: false },
  { name: 'Line', token: 'line', hex: 'stone-800 / 60%', role: '1px hairline dividers', swatch: 'bg-line', dark: true },
  { name: 'Edge', token: 'edge', hex: '#78716C', role: 'Form control borders', swatch: 'bg-edge', dark: true },
  { name: 'Champagne', token: 'champagne', hex: '#D4AF37', role: 'Accent, links, primary CTA', swatch: 'bg-champagne', dark: false },
  { name: 'Neem', token: 'neem', hex: '#2F6B4F', role: 'WhatsApp only', swatch: 'bg-neem', dark: true },
  { name: 'Alert', token: 'alert', hex: '#E8907A', role: 'Form errors, RERA pending', swatch: 'bg-alert', dark: false },
];

const typeScale = [
  { cls: 'font-display text-h1 font-medium', label: 'h1 · Cormorant 72/72 · 500', sample: 'Full price, upfront.' },
  { cls: 'font-display text-h2 font-medium', label: 'h2 · Cormorant 46/49 · 500', sample: 'New launches in Greater Noida' },
  { cls: 'font-display text-h3 font-medium', label: 'h3 · Cormorant 36/40 · 500', sample: 'Hero Homes, Sector Mu' },
  { cls: 'font-display text-h4 font-medium', label: 'h4 · Cormorant 28/33 · 500', sample: 'Leafsong Retreat' },
  { cls: 'text-lead', label: 'lead · Plus Jakarta 19/30 · 400', sample: 'Every listing comes with its RERA number and an all-inclusive price breakup.' },
  { cls: 'text-body', label: 'body · Plus Jakarta 16/27 · 400', sample: 'One advisor stays with you from the first site visit to registry, including loan paperwork.' },
  { cls: 'figures text-lead font-semibold', label: 'figures · Plus Jakarta tabular · 600', sample: '₹1.82–2.52 Cr · 1,656 sq. ft.' },
  { cls: 'text-small text-mist', label: 'small · 13/20 · 400', sample: 'Prices are all-inclusive unless stated.' },
  { cls: 'text-lead', label: 'Hindi · Mukta 400 (fallback)', sample: 'भरोसा, लिखित में। पूरा दाम, पहले दिन से।' },
];

const priceSamples = [4500000, 7850000, 9999900, 12000000, 12500000, 18500];
const section = 'mx-auto max-w-site px-4 py-12 sm:px-6 md:py-16';
const label = 'text-small font-semibold text-mist';
---

<BaseLayout title="Styleguide" noindex>
  <div class={section}>
    <h1 class="text-h2 font-medium md:text-h1">Styleguide</h1>
    <p class="mt-3 max-w-[60ch] text-lead text-mist">
      Tokens and components for review. This page is not linked anywhere and is hidden from search
      engines. Resize the window to see the header menu and the mobile Call / WhatsApp bar.
    </p>
  </div>

  <section class={section} aria-labelledby="sg-colour">
    <SectionHeading title="Colour" intro="Canvas and surface carry almost every layout. Champagne stays rare: links, the primary button and the verification ring." />
    <ul id="sg-colour" class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
      {colours.map((c) => (
        <li class="overflow-hidden rounded-card border border-line bg-surface">
          <div class:list={['h-20', c.swatch]} />
          <div class="p-3">
            <p class="font-semibold">{c.name}</p>
            <p class="text-small text-mist tabular-nums">{c.hex} · <code>{c.token}</code></p>
            <p class="mt-1 text-small">{c.role}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class={section} aria-label="Typography">
    <SectionHeading title="Type" intro="Cormorant Garamond for headings and project names. Plus Jakarta Sans for body text, prices and areas, with tabular figures. Mukta renders Hindi." />
    <ul class="mt-8 divide-y divide-line border-y border-line">
      {typeScale.map((t) => (
        <li class="grid gap-1 py-5 md:grid-cols-[12rem_1fr] md:items-baseline md:gap-6">
          <span class={label}>{t.label}</span>
          <span class:list={[t.cls, 'min-w-0 break-words']}>{t.sample}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class={section} aria-label="Buttons">
    <SectionHeading title="Buttons" intro="Every label names what the buyer gets. All sizes are at least 44px tall." />
    <div class="mt-8 flex flex-col gap-6">
      <div class="flex flex-wrap items-center gap-3">
        <Button href="#">Get price sheet</Button>
        <Button variant="secondary" href="#">Book a free site visit</Button>
        <Button variant="whatsapp" icon="chat" href="#">Chat on WhatsApp</Button>
        <Button icon="phone" href="#">Call an advisor</Button>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <Button size="sm">Small</Button>
        <Button>Medium</Button>
        <Button size="lg">Large</Button>
      </div>
      <div class="flex flex-wrap items-center gap-3 rounded-card bg-canvas p-5">
        <Button variant="inverse">Get price sheet</Button>
        <Button variant="whatsapp" icon="chat">Chat on WhatsApp</Button>
      </div>
    </div>
  </section>

  <section class={section} aria-label="Badges">
    <SectionHeading title="Badges" intro="Status badges are outlined so they read as facts. Category and launch badges are solid so they hold up on photos." />
    <dl class="mt-8 grid gap-6 sm:grid-cols-3">
      <div class="flex flex-col gap-3">
        <dt class={label}>Status</dt>
        <dd class="flex flex-wrap gap-2">
          <Badge status="ready-to-move" />
          <Badge status="under-construction" />
          <Badge status="upcoming" />
        </dd>
      </div>
      <div class="flex flex-col gap-3">
        <dt class={label}>Category</dt>
        <dd class="flex flex-wrap gap-2">
          <Badge category="residential" />
          <Badge category="commercial" />
          <Badge category="plot" />
          <Badge category="pg-rental" />
        </dd>
      </div>
      <div class="flex flex-col gap-3">
        <dt class={label}>Launch and verification</dt>
        <dd class="flex flex-wrap items-center gap-3">
          <Badge launch />
          <span class="inline-flex items-center gap-1.5 text-small font-medium"><Ring />RERA checked</span>
        </dd>
      </div>
    </dl>
  </section>

  <section class={section} aria-label="Prices">
    <SectionHeading title="Prices" intro="Stored as rupees, shown in Lakh and Cr through one helper. Figures are tabular so columns line up." />
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div class="flex flex-col gap-4 rounded-card bg-surface p-5">
        <PriceTag min={7800000} max={11000000} size="lg" />
        <PriceTag min={12000000} max={18000000} />
        <PriceTag min={4500000} max={6000000} />
        <PriceTag min={14200000} note="total cost, incl. PLC and parking" />
        <PriceTag min={18500} per="/month" note="" />
      </div>
      <table class="w-full text-left tabular-nums">
        <caption class="sr-only">Formatter output</caption>
        <thead>
          <tr class="border-b border-line">
            <th scope="col" class:list={[label, 'py-2']}>Stored value</th>
            <th scope="col" class:list={[label, 'py-2']}>Shown as</th>
          </tr>
        </thead>
        <tbody>
          {priceSamples.map((n) => (
            <tr class="border-b border-line">
              <td class="py-2 text-mist">{n}</td>
              <td class="py-2 font-semibold">{formatPrice(n)}</td>
            </tr>
          ))}
          <tr class="border-b border-line">
            <td class="py-2 text-mist">7800000, 11000000</td>
            <td class="py-2 font-semibold">{formatPriceRange(7800000, 11000000)}</td>
          </tr>
          <tr class="border-b border-line">
            <td class="py-2 text-mist">1650 / 1150–1650</td>
            <td class="py-2 font-semibold">{formatArea(1650)} / {formatAreaRange(1150, 1650)}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class={section} aria-label="Section headings">
    <div class="flex flex-col gap-12">
      <SectionHeading
        title="Verified projects in Sector 150"
        intro="Each one has been visited by our team and comes with an all-inclusive price sheet."
        link={{ label: 'See all projects', href: '#' }}
      />
      <SectionHeading as="h3" title="Nearby schools and hospitals" />
      <SectionHeading align="center" title="Not sure where to start?" intro="Tell us your budget and preferred area on WhatsApp. We'll reply with verified options." />
    </div>
  </section>

  <section id="cards" class={section} aria-label="Project cards">
    <SectionHeading title="Project cards" intro="Sample data. Images are placeholders until real site photos arrive." />
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {samples.map((p, i) => <ProjectCard project={p} newLaunch={i === 1} />)}
    </div>
  </section>

  <section class={section} aria-label="Graphic devices">
    <SectionHeading title="Skyline rule" intro="Footer edge and section divider. The sun sits between the towers." />
    <SkylineRule class="mt-8" />
  </section>
</BaseLayout>
