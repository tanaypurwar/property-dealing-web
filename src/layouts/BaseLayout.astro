---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import ContactDock from '../components/layout/ContactDock.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** Keep internal pages (styleguide, drafts) out of search results. */
  noindex?: boolean;
  /** Pre-filled WhatsApp message for this page. */
  whatsappMessage?: string;
  /** Social share image (Open Graph / Twitter). Resized to 1200×630. */
  image?: ImageMetadata;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  /** Show the desktop floating WhatsApp button. */
  floatingWhatsApp?: boolean;
  /** Structured data, rendered as one JSON-LD script per object. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'Verified, RERA-registered projects in Noida and Greater Noida, each with an all-inclusive price sheet and one advisor till registry.',
  noindex = false,
  whatsappMessage,
  image,
  imageAlt,
  ogType = 'website',
  jsonLd = [],
  floatingWhatsApp = true,
} = Astro.props;

const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = image
  ? new URL(
      (await getImage({ src: image, width: 1200, height: 630, format: 'jpg', fit: 'cover' })).src,
      Astro.site ?? site.url,
    ).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {
      jsonLd.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
      ))
    }
    <meta name="theme-color" content="#faf7f2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Mukta:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-control bg-ink px-4 py-3 font-display font-bold text-paper focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <ContactDock message={whatsappMessage} floating={floatingWhatsApp} />
  </body>
</html>
