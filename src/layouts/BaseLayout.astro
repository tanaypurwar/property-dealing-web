---
import '../styles/global.css';
import ContactDock from '../components/layout/ContactDock.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description?: string;
  /** Keep internal pages (styleguide, drafts) out of search results. */
  noindex?: boolean;
  /** Pre-filled WhatsApp message for this page. */
  whatsappMessage?: string;
}

const {
  title,
  description = 'Verified, RERA-registered projects in Noida and Greater Noida, each with an all-inclusive price sheet and one advisor till registry.',
  noindex = false,
  whatsappMessage,
} = Astro.props;

const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#faf7f2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Mukta:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-control bg-ink px-4 py-3 font-display font-bold text-paper focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <ContactDock message={whatsappMessage} />
  </body>
</html>
