---
/**
 * Section title with an optional intro and an optional link to "see all" on the right.
 * Left-aligned by default; `center` is for short standalone sections (e.g. a final CTA).
 */
interface Props {
  title: string;
  /** Id for the heading, so a section can point aria-labelledby at it. */
  id?: string;
  intro?: string;
  /** Heading level. Pages own their single h1, so sections default to h2. */
  as?: 'h1' | 'h2' | 'h3';
  link?: { label: string; href: string };
  align?: 'left' | 'center';
  class?: string;
}

const { title, id, intro, as: Tag = 'h2', link, align = 'left', class: className } = Astro.props;

const sizes = {
  h1: 'text-h2 md:text-h1',
  h2: 'text-h3 md:text-h2',
  h3: 'text-h4 md:text-h3',
};
---

<header
  class:list={[
    'flex flex-col gap-3',
    align === 'center' ? 'items-center text-center' : 'sm:flex-row sm:items-end sm:justify-between',
    className,
  ]}
>
  <div class:list={['flex max-w-[40rem] flex-col gap-2', align === 'center' && 'items-center']}>
    <Tag id={id} class:list={[sizes[Tag], 'text-alabaster']}>{title}</Tag>
    {intro && <p class="max-w-[60ch] text-lead text-mist">{intro}</p>}
  </div>
  {
    link && (
      <a
        href={link.href}
        class="inline-flex min-h-tap shrink-0 items-center font-medium text-champagne underline decoration-1 underline-offset-[6px] hover:text-alabaster"
      >
        {link.label}
      </a>
    )
  }
</header>
