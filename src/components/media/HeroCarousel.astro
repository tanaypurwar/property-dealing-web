---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';

/**
 * Swipeable image carousel built on CSS scroll-snap; the script only wires up the
 * arrows and the counter. The first slide is the LCP image, so it loads eagerly.
 */
interface Props {
  label: string;
  /** `contain` shows the whole image (for ads and slides with text) instead of cropping it. */
  slides: { src: ImageMetadata; alt: string; caption?: string; contain?: boolean }[];
  /** `page`: full-width project hero. `compact`: a 2:1 box (the shape of most launch ads), e.g. the home page spotlight. */
  variant?: 'page' | 'compact';
}

const { label, slides, variant = 'page' } = Astro.props;
const compact = variant === 'compact';
const sizes = compact ? '(min-width: 1200px) 640px, (min-width: 1024px) 54vw, 100vw' : '(min-width: 1200px) 1168px, 100vw';
---

<div class:list={['relative overflow-hidden bg-surface', compact ? 'rounded-card' : 'md:rounded-card']} role="region" aria-roledescription="carousel" aria-label={label} data-carousel>
  <ul
    class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    data-carousel-track
    tabindex="0"
    aria-label={`${label}, swipe or use the arrow buttons`}
  >
    {
      slides.map((slide, i) => (
        <li
          class="relative w-full shrink-0 snap-start"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}`}
        >
          {slide.contain ? (
            <Image
              src={slide.src}
              alt={slide.alt}
              width={Math.min(1600, slide.src.width)}
              height={Math.round((Math.min(1600, slide.src.width) * slide.src.height) / slide.src.width)}
              sizes={sizes}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class:list={[
                'w-full bg-canvas object-contain',
                compact ? 'aspect-[2/1]' : 'aspect-[16/10] md:aspect-auto md:h-[min(62vh,520px)]',
              ]}
            />
          ) : (
            <Image
              src={slide.src}
              alt={slide.alt}
              width={1600}
              height={1000}
              widths={[640, 960, 1280, 1600]}
              sizes={sizes}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class:list={[
                'w-full object-cover',
                compact ? 'aspect-[2/1]' : 'aspect-[16/10] md:aspect-auto md:h-[min(62vh,520px)]',
              ]}
            />
          )}
          {slide.caption && (
            <p class="absolute bottom-3 left-3 max-w-[80%] rounded-badge bg-canvas/90 px-2 py-0.5 text-small text-mist">
              {slide.caption}
            </p>
          )}
        </li>
      ))
    }
  </ul>

  {
    slides.length > 1 && (
      <>
        <button
          type="button"
          data-carousel-prev
          class:list={['absolute top-1/2 hidden -translate-y-1/2 items-center justify-center rounded-full bg-canvas/90 text-alabaster shadow-float hover:bg-canvas sm:inline-flex', compact ? 'size-10 left-2 opacity-80 hover:opacity-100' : 'size-12 left-3']}
        >
          <span class="sr-only">Previous image</span>
          <Icon name="chevronLeft" size={24} />
        </button>
        <button
          type="button"
          data-carousel-next
          class:list={['absolute top-1/2 hidden -translate-y-1/2 items-center justify-center rounded-full bg-canvas/90 text-alabaster shadow-float hover:bg-canvas sm:inline-flex', compact ? 'size-10 right-2 opacity-80 hover:opacity-100' : 'size-12 right-3']}
        >
          <span class="sr-only">Next image</span>
          <Icon name="chevronRight" size={24} />
        </button>
        <p
          class="absolute right-3 bottom-3 rounded-badge bg-canvas/80 px-2 py-0.5 text-small font-semibold text-alabaster tabular-nums"
          data-carousel-count
          aria-hidden="true"
        >
          1 / {slides.length}
        </p>
      </>
    )
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const count = root.querySelector<HTMLElement>('[data-carousel-count]');
    const total = track.children.length;
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: ((i + total) % total) * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    };

    root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => go(index() - 1));
    root.querySelector('[data-carousel-next]')?.addEventListener('click', () => go(index() + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index() - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
    });
    track.addEventListener('scroll', () => {
      if (count) count.textContent = `${index() + 1} / ${total}`;
    }, { passive: true });
  }
</script>
