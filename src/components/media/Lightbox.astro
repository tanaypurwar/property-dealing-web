---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';

/**
 * A full-screen image viewer. Open it from any element with
 * `data-lightbox-open="<id>"` and `data-index="<n>"`. Full-size images are lazy,
 * so nothing downloads until the viewer opens on them.
 */
interface Props {
  id: string;
  label: string;
  items: { src: ImageMetadata; alt: string; caption?: string }[];
}

const { id, label, items } = Astro.props;
---

<dialog
  id={id}
  data-lightbox
  aria-label={label}
  class="m-0 h-dvh max-h-none w-full max-w-none bg-canvas/95 p-0 text-alabaster backdrop:bg-canvas/80 open:flex open:flex-col"
>
  <div class="flex items-center justify-between gap-4 px-4 py-2">
    <p class="text-small font-semibold tabular-nums" aria-live="polite" data-lightbox-count>
      1 of {items.length}
    </p>
    <button
      type="button"
      data-lightbox-close
      class="inline-flex size-tap items-center justify-center rounded-control hover:bg-canvas/10"
    >
      <span class="sr-only">Close</span>
      <Icon name="close" size={26} />
    </button>
  </div>

  <div class="relative flex min-h-0 flex-1 items-center justify-center px-2 pb-4 sm:px-16">
    {
      items.map((item, i) => (
        <figure data-lightbox-item hidden={i !== 0} class="flex h-full w-full flex-col items-center justify-center gap-3">
          <Image
            src={item.src}
            alt={item.alt}
            width={Math.min(1600, item.src.width)}
            height={Math.round((Math.min(1600, item.src.width) * item.src.height) / item.src.width)}
            loading="lazy"
            class="max-h-[calc(100%-3rem)] w-auto max-w-full rounded-control bg-canvas object-contain"
          />
          {item.caption && <figcaption class="text-center text-alabaster/85">{item.caption}</figcaption>}
        </figure>
      ))
    }
    {
      items.length > 1 && (
        <>
          <button
            type="button"
            data-lightbox-prev
            class="absolute top-1/2 left-2 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-canvas/70 transition-colors duration-200 ease-hover hover:bg-champagne hover:text-canvas"
          >
            <span class="sr-only">Previous image</span>
            <Icon name="chevronLeft" size={26} />
          </button>
          <button
            type="button"
            data-lightbox-next
            class="absolute top-1/2 right-2 inline-flex size-12 -translate-y-1/2 items-center justify-center rounded-full bg-canvas/70 transition-colors duration-200 ease-hover hover:bg-champagne hover:text-canvas"
          >
            <span class="sr-only">Next image</span>
            <Icon name="chevronRight" size={26} />
          </button>
        </>
      )
    }
  </div>
</dialog>

<script>
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog[data-lightbox]')) {
    const items = [...dialog.querySelectorAll<HTMLElement>('[data-lightbox-item]')];
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + items.length) % items.length;
      items.forEach((el, n) => (el.hidden = n !== current));
      count.textContent = `${current + 1} of ${items.length}`;
    };

    document.querySelectorAll<HTMLElement>(`[data-lightbox-open="${dialog.id}"]`).forEach((el) =>
      el.addEventListener('click', () => {
        opener = el;
        show(Number(el.dataset.index ?? 0));
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // A tap on the dark area around the image closes the viewer.
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.matches('figure')) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());

    // Swipe between images on touch screens.
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0]!.clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0]!.clientX - startX;
      if (Math.abs(dx) > 50 && items.length > 1) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>
