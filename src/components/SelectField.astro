---
import Icon from './Icon.astro';

/** A labelled native select. Native keeps it light and gives phones their own picker. */
interface Props {
  label: string;
  name: string;
  options: readonly { value: string; label: string }[];
  /** Label for the empty "no filter" option. Omit when a choice is always required (sort). */
  anyLabel?: string;
  value?: string;
  id?: string;
  form?: string;
  /** Sits inside the filter console: from md up, the console draws the frame and the field goes borderless. */
  inConsole?: boolean;
  class?: string;
}

const {
  label,
  name,
  options,
  anyLabel,
  value = '',
  id = `field-${name}`,
  form,
  inConsole = false,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'flex min-w-0 flex-col gap-1',
    inConsole && 'md:gap-0 md:px-5 md:py-3 md:transition-colors md:focus-within:bg-raised/50 md:hover:bg-raised/30',
    className,
  ]}
>
  <label for={id} class="text-[0.75rem] leading-4 font-medium tracking-[0.02em] text-mist">{label}</label>
  <div class="relative">
    <select
      id={id}
      name={name}
      form={form}
      class:list={[
        'min-h-tap w-full cursor-pointer appearance-none truncate rounded-control border border-edge/70 bg-surface py-2 pr-10 pl-3 text-body text-alabaster transition-colors hover:border-mist focus-visible:border-champagne focus-visible:outline-none',
        inConsole && 'md:min-h-8 md:border-0 md:bg-transparent md:py-0 md:pr-7 md:pl-0 md:font-medium md:focus-visible:outline-none',
      ]}
    >
      {anyLabel !== undefined && <option value="" selected={value === ''}>{anyLabel}</option>}
      {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
    </select>
    <Icon
      name="chevronDown"
      size={18}
      class:list={[
        'pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-mist',
        inConsole && 'md:right-0 md:size-4',
      ]}
    />
  </div>
</div>
