---
import Icon from './Icon.astro';

/** A labelled native select. Native keeps it light and gives phones their own picker. */
interface Props {
  label: string;
  name: string;
  options: readonly { value: string; label: string }[];
  /** Label for the empty "no filter" option. Omit when a choice is always required (sort). */
  anyLabel?: string;
  value?: string;
  id?: string;
  form?: string;
  class?: string;
}

const { label, name, options, anyLabel, value = '', id = `field-${name}`, form, class: className } =
  Astro.props;
---

<div class:list={['flex min-w-0 flex-col gap-1', className]}>
  <label for={id} class="font-display text-small font-bold text-stone">{label}</label>
  <div class="relative">
    <select
      id={id}
      name={name}
      form={form}
      class="min-h-tap w-full cursor-pointer appearance-none truncate rounded-control border border-line bg-white py-2 pr-10 pl-3 text-body text-ink hover:border-stone"
    >
      {anyLabel !== undefined && <option value="" selected={value === ''}>{anyLabel}</option>}
      {options.map((o) => <option value={o.value} selected={o.value === value}>{o.label}</option>)}
    </select>
    <Icon
      name="chevronDown"
      size={18}
      class="pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-stone"
    />
  </div>
</div>
