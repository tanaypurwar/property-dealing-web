---
import Ring from './Ring.astro';
import {
  STATUS_LABELS,
  TYPE_LABELS,
  type ProjectStatus as Status,
  type ProjectType as Category,
} from '../lib/project-filters';

/**
 * Pass one of:
 * - `status` for construction stage,
 * - `category` for the project type,
 * - `launch` for the "New launch" badge.
 * All three are muted, translucent capsules so they read as facts, not promos, on photos and on canvas.
 */
type Props =
  | { status: Status; category?: never; launch?: never; class?: string }
  | { category: Category; status?: never; launch?: never; class?: string }
  | { launch: true; status?: never; category?: never; class?: string };

const props = Astro.props;

// Only "ready to move" gets a lit dot: it is the one status a buyer can act on today.
const statusDot: Record<Status, string> = {
  upcoming: 'border border-mist',
  'under-construction': 'bg-mist',
  'ready-to-move': 'bg-champagne',
};

const base =
  'inline-flex items-center gap-1.5 rounded-badge border border-alabaster/15 bg-canvas/65 px-2.5 py-0.5 text-[0.75rem] leading-5 font-medium tracking-[0.01em] whitespace-nowrap text-alabaster backdrop-blur-md';
---

{
  'status' in props && props.status && (
    <span class:list={[base, props.class]}>
      <span aria-hidden="true" class:list={['size-1.5 rounded-full', statusDot[props.status]]} />
      {STATUS_LABELS[props.status]}
    </span>
  )
}
{
  'category' in props && props.category && (
    <span class:list={[base, props.class]}>{TYPE_LABELS[props.category]}</span>
  )
}
{
  'launch' in props && props.launch && (
    <span class:list={[base, 'border-champagne/50 text-champagne', props.class]}>
      <Ring />
      New launch
    </span>
  )
}
