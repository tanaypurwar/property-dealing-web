---
interface Props {
  id: string;
  /** What we'll contact them about: "this project", "property options". */
  subject?: string;
}

const { id, subject = 'this project' } = Astro.props;
---

<div class="flex flex-col gap-1">
  <label for={id} class="flex cursor-pointer items-start gap-3 py-1 text-small text-ink">
    <input
      id={id}
      name="consent"
      type="checkbox"
      aria-describedby={`${id}-error`}
      class="mt-0.5 size-5 shrink-0 cursor-pointer accent-deep"
    />
    <span>
      Call or WhatsApp me about {subject}. My number is never shared with other brokers.
    </span>
  </label>
  <p id={`${id}-error`} hidden class="text-small font-medium text-deep"></p>
</div>
