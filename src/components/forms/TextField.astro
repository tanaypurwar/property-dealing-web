---
import type { HTMLAttributes } from 'astro/types';

/** A labelled input with optional hint and an inline error slot (`#<id>-error`) for lead forms. */
type Props = {
  id: string;
  label: string;
  name: string;
  optional?: boolean;
  hint?: string;
  /** Fixed text shown inside the field before the input, e.g. "+91". */
  prefix?: string;
} & Omit<HTMLAttributes<'input'>, 'id' | 'name'>;

const { id, label, name, optional = false, hint, prefix, ...rest } = Astro.props;
const describedBy = [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');
---

<div class="flex flex-col gap-1">
  <label for={id} class="font-display text-small font-bold text-stone">
    {label}
    {optional && <span class="font-sans font-normal text-stone"> (optional)</span>}
  </label>
  <div
    class="flex min-h-tap items-center rounded-control border border-line bg-white focus-within:border-ink has-[[aria-invalid=true]]:border-deep"
  >
    {prefix && <span class="pl-3 text-stone tabular-nums" aria-hidden="true">{prefix}</span>}
    <input
      id={id}
      name={name}
      aria-describedby={describedBy}
      class="min-h-tap w-full min-w-0 rounded-control bg-transparent px-3 text-body text-ink outline-none placeholder:text-stone/70"
      {...rest}
    />
  </div>
  {hint && <p id={`${id}-hint`} class="text-small text-stone">{hint}</p>}
  <p id={`${id}-error`} hidden class="text-small font-medium text-deep"></p>
</div>
