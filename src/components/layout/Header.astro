---
import Logo from '../../../brand/logo/propertydealing-mono-white.svg';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { site } from '../../config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-site items-center gap-2 px-4 sm:px-6 lg:h-[4.5rem]">
    <a href="/" class="mr-auto flex min-h-tap items-center" aria-label={`${site.name} home`}>
      <Logo width={136} height={18} aria-hidden="true" class="h-auto w-[136px] lg:w-[168px]" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="flex min-h-tap items-center px-3 text-[0.9375rem] font-medium text-alabaster/85 hover:text-champagne aria-[current=page]:text-champagne aria-[current=page]:underline aria-[current=page]:decoration-champagne aria-[current=page]:decoration-1 aria-[current=page]:underline-offset-8"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={site.enquireHref} size="sm" class="lg:ml-4 lg:px-5">
      <span class="sm:hidden">Price sheet</span>
      <span class="hidden sm:inline">Get price sheet</span>
    </Button>

    <button
      type="button"
      class="group -mr-2 inline-flex size-tap items-center justify-center rounded-control text-alabaster hover:bg-raised lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <Icon name="menu" size={24} class="group-aria-expanded:hidden" />
      <Icon name="close" size={24} class="hidden group-aria-expanded:block" />
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Main"
    class="hidden border-t border-line bg-canvas shadow-raise lg:hidden"
    data-menu
  >
    <ul class="mx-auto flex max-w-site flex-col px-4 py-2 sm:px-6">
      {
        site.nav.map((item) => (
          <li class="border-b border-line last:border-0">
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="flex min-h-14 items-center font-display text-h4 font-medium text-alabaster aria-[current=page]:text-champagne"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    // Close if the viewport grows past the breakpoint with the menu open.
    matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
