---
/**
 * The verification ring: a fragment of the logo that marks a fact we have checked
 * (RERA number, price sheet). Decorative; the text next to it carries the meaning.
 */
interface Props {
  /** `champagne` on canvas and surface, `canvas` when sitting on a champagne fill. */
  tone?: 'champagne' | 'canvas';
  class?: string;
}

const { tone = 'champagne', class: className } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    'inline-block size-[0.625rem] shrink-0 rounded-full border-[1.5px]',
    tone === 'champagne' ? 'border-champagne' : 'border-canvas',
    className,
  ]}
></span>
