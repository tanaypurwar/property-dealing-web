---
/**
 * The verification ring: a fragment of the logo that marks a fact we have checked
 * (RERA number, price sheet). Decorative; the text next to it carries the meaning.
 */
interface Props {
  /** `sun` on light and dark grounds, `ink` when sitting on a Sunrise badge. */
  tone?: 'sun' | 'ink';
  class?: string;
}

const { tone = 'sun', class: className } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    'inline-block size-[0.6875rem] shrink-0 rounded-full border-[2.5px]',
    tone === 'sun' ? 'border-sun' : 'border-ink',
    className,
  ]}
></span>
