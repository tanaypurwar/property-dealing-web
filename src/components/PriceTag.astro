---
import { formatPrice, formatPriceRange } from '../lib/format';

/**
 * A price in rupees, formatted as Lakh/Cr. Pass `min` alone for a single price,
 * or `min` and `max` for a range. Figures are tabular so stacked prices align.
 */
interface Props {
  min: number;
  max?: number;
  /** What the figure includes. Shown beside the price; set to "" to hide. */
  note?: string;
  /** e.g. "/month" for rentals */
  per?: string;
  size?: 'md' | 'lg';
  class?: string;
}

const { min, max, note = 'all-inclusive', per, size = 'md', class: className } = Astro.props;

const value = max === undefined ? formatPrice(min) : formatPriceRange(min, max);
---

<p class:list={['flex flex-wrap items-baseline gap-x-2', className]}>
  <strong
    class:list={[
      'font-display font-extrabold tabular-nums tracking-tight text-ink',
      size === 'lg' ? 'text-h4 sm:text-h3' : 'text-[1.3125rem] leading-7',
    ]}
  >
    {value}
    {per && <span class="text-body font-bold text-stone">{per}</span>}
  </strong>
  {note && <span class="text-small text-stone">{note}</span>}
</p>
