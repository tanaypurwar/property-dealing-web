---
import { formatPrice, formatPriceRange } from '../lib/format';

/**
 * A price in rupees, formatted as Lakh/Cr. Pass `min` alone for a single price,
 * or `min` and `max` for a range. Figures are tabular so stacked prices align.
 */
interface Props {
  min: number;
  max?: number;
  /** Only a starting price is known: shows "From ₹X". */
  from?: boolean;
  /** What the figure includes. Shown beside the price; set to "" to hide. */
  note?: string;
  /** e.g. "/month" for rentals */
  per?: string;
  size?: 'md' | 'lg';
  class?: string;
}

const { min, max, from = false, note = 'all-inclusive', per, size = 'md', class: className } = Astro.props;

const value = max === undefined ? formatPrice(min) : formatPriceRange(min, max);
---

<p class:list={['flex flex-wrap items-baseline gap-x-2', className]}>
  <strong
    class:list={[
      'figures font-semibold text-alabaster',
      size === 'lg' ? 'text-[1.75rem] leading-9 sm:text-[2rem] sm:leading-10' : 'text-[1.25rem] leading-7',
    ]}
  >
    {from && <span class:list={['font-medium text-mist', size === 'lg' ? 'text-lead' : 'text-body']}>From </span>}
    {value}
    {per && <span class="text-body font-medium text-mist">{per}</span>}
  </strong>
  {note && <span class="text-small text-mist">{note}</span>}
</p>
